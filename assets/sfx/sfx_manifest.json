  "purpose": "Generation and wiring manifest for Armor Command sound effects. Use this as the batch plan for generated/procedural/source SFX.",
  "mix": {
    "music_volume_runtime": 0.72,
    "sfx_master_runtime": 0.45,
    "one_shot_target_lufs": -16,
    "loop_target_lufs": -20,
    "latency_rule": "Trim leading silence aggressively; gameplay one-shots should begin audibly within 20 ms.",
    "sfx_output_gain_runtime": 0.72
  },
  "runtime_notes": [
    "Current enemy slain chime is procedural WebAudio in src/main.js and keyed to MUSIC_TRACK_KEYS.",
    "Generated one-shots should use small random pitch variation at playback time where repeated rapidly.",
    "Use preloaded pooled playback or decoded buffers when wiring file-based SFX.",
    "v0.1.4 pass: manifest sounds are implemented as procedural WebAudio in src/main.js; prompts remain for future rendered asset replacement.",
    "v0.1.5 pass: high-impact one-shots were rendered as deterministic WAV assets and are played through decoded WebAudio buffers with compressor bus, pitch variation, and procedural fallback.",
    "v0.1.6 pass: SFX master was reduced from 1.35 to 1.02 after rendered WAVs tested about 25% too loud against music.",
    "v0.1.6 pass: drop pod, trooper rocket, trooper shatter, and enemy rocket pop SFX were added as rendered WAV buffers.",
    "v0.1.7 pass: SFX master was reduced from 1.02 to 0.71 after hosted playback still tested about 30% too loud.",
    "v0.1.8 pass: added post-compressor output gain 0.72, lowered source SFX master to 0.45, and cache-busted src/main.js because hosted/mobile playback did not reflect the prior reduction clearly.",
    "v1.0.0 pass: added persistent SFX toggle stored under armor-command.sfx-disabled.v1; disabled SFX mutes the WebAudio output bus and suppresses new one-shots.",
    "v1.0.0 pass: removed the HUD music toggle; music and SFX toggles now live in title and pause menus."
  ],
